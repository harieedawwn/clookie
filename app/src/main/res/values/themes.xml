<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Clookie" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Ringing screen: solid color from the first frame, no splash. -->
    <style name="Theme.Clookie.Ringing" parent="Theme.Clookie">
        <item name="android:windowBackground">@color/brand_jam</item>
    </style>

    <style name="Theme.Clookie.Splash" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/brand_cream</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_jam</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Clookie</item>
    </style>
</resources>